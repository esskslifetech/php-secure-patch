# ==============================================================================
# PHP2Shell minimal backport for end-of-life branches (PHP 7.4 / 8.0 / 8.1)
# Mirrors PHP's official "minimal source backports": force the CVE-2026-109619
# exploit producer (session.upload_progress) OFF regardless of php.ini.
#  * default "1" -> "0"
#  * ZEND_INI_PERDIR -> ZEND_INI_SYSTEM so .user.ini / ini_set() cannot
#    re-enable it (php.net: mitigation must apply before request parsing)
# Like the official minimal backports this adds NO hard memory limit — pair it
# with the toolkit's ini hardening (memory_limit / post_max_size bounds) for
# CVE-2026-109618 containment.
# Apply:  cd php-src && patch -p1 < php2shell-minimal-backport-7.4-8.1.patch
# Verified against php-7.4.33 / php-8.0.30 / php-8.1.29; also applies to 8.2+.
# ==============================================================================
--- a/ext/session/session.c
+++ b/ext/session/session.c
@@ -1,2 +1,2 @@
 	STD_PHP_INI_BOOLEAN("session.upload_progress.enabled",
-	                                                "1",     ZEND_INI_PERDIR, OnUpdateBool,        rfc1867_enabled, php_ps_globals, ps_globals)
+	                                                "0",     ZEND_INI_SYSTEM, OnUpdateBool,        rfc1867_enabled, php_ps_globals, ps_globals)
