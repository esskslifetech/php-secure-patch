# Normalise everything to LF in the repository and in the working tree, so a
# checkout on Windows cannot inject CRLF into scripts that must run on Linux.
* text=auto eol=lf

*.sh        text eol=lf
*.patch     text eol=lf
*.diff      text eol=lf
*.ini       text eol=lf
*.conf      text eol=lf
*.htaccess  text eol=lf
*.md        text eol=lf
*.php       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf

# Windows tooling keeps CRLF (PowerShell, cmd, batch).
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
